// The educateos.io site (SCHO-206). Deliberately outside `packages/`: release discovery
// (`scripts/release/manifest-lib.ts`) and config generation (`scripts/generate-worker-configs.ts`)
// scan only `packages/`, and this Worker is the project's own site, never part of a district
// release (ADR-0013).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "educateos-site",
  "compatibility_date": "2026-10-01",
  // The dashboard probes installations' public hostnames, some on this same zone: send those
  // requests the way any visitor's would go, to whichever Worker serves the hostname.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // A script, not an assets-only Worker: Cloudflare keeps no vars on an assets-only version, so
  // ForgeGraph's FG_COMMIT_HASH would be dropped and its source-order guard would refuse every
  // later deploy (SCHO-233). Requests that match a file never reach the script, except on the paths
  // run_worker_first names: the operator console, the opt-in registry and the health check
  // (SCHO-206), and Clever portal launches (SCHO-249).
  "main": "worker.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Must equal DYNAMIC_PATHS in packages/educateos-control-plane/src/app.ts (site-config.test.mjs).
    "run_worker_first": ["/healthz", "/app", "/app/*", "/registry/*", "/clever/launch"]
  },
  // The control plane's operators and installations. This Worker owns the data, so it must never
  // be renamed, nor the class (SCHO-231): a new name starts an empty namespace.
  "durable_objects": {
    "bindings": [{ "name": "CONTROL_PLANE", "class_name": "ControlPlane" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ControlPlane"] }],
  // Secrets, set with `wrangler secret put` (never in this file): CLEVER_CLIENT_ID and
  // CLEVER_CLIENT_SECRET, the educateos.io Clever app's OAuth client, for /clever/launch (SCHO-249).
  "vars": {
    // The Access application "EducateOS operator console" (9074c7b7) guards educateos.io/app: anyone
    // with a verified email (one-time PIN or GitHub). The Worker verifies each assertion with these.
    "ACCESS_ISSUER": "https://gmacko.cloudflareaccess.com",
    "ACCESS_AUD": "a44a7642d3b9478736c0ba4f218608ab9934fd9e0b8b45cb642ebd2709654a92",
    // Clever portal launches (SCHO-249) for the project's own demo districts, which are not
    // registered installations: Clever district ID to managed hostname. A demo bridge until the
    // guided install writes installation rows; the registry is consulted first. Only
    // <slug>.educateos.io hosts are accepted. 6ade4156… is the educateos-dev app's sandbox district.
    "CLEVER_LAUNCH_DISTRICTS": "{\"6ade41569b8cebb96d733c48\":\"northfield.educateos.io\"}",
    // Where a Clever user in no district goes: a teacher who authorized the app themselves, as
    // every sandbox demo login is. Clever names no district for them to route by.
    "CLEVER_LAUNCH_UNAFFILIATED": "northfield.educateos.io",
    // The release keys the guided install verifies every release against before installing it
    // (docs/educateos/control-plane.md, "Release keys"). Public halves only.
    "RELEASE_TRUST": {"root": {"threshold": 1, "keys": [{"keyId": "ed25519-ZcqIp-xFaMyAdLm9A_VLfM9gzi-04hir2JmHXqornqc", "publicKey": "mUuoDdWb6ERTjC_o3SI4hYf6pdb7tElPlkoVqPxx24k"}]}, "keySetVersion": 0, "keys": [{"keyId": "ed25519-Y5ayv_OFgjE5j_YaqCuiuNvx-H7_d6AVfSjTnQlIc58", "publicKey": "LVFy9O5qtmgvCGs0uhfjF9Q3aJZ4cQhrYYyouuF6YKg"}]}
  },
  // Signed releases for the guided install, laid out as scripts/release/upload-release.ts writes
  // them. Read-only in practice: the Worker never writes to it.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "educateos-releases" }],
  "routes": [
    { "pattern": "educateos.io", "custom_domain": true },
    { "pattern": "www.educateos.io", "custom_domain": true },
    // educateos.dev must serve a live page as the base of Google's Workspace for Education
    // developer demo domain, gedu.demo.educateos.dev (SCHO-211).
    { "pattern": "educateos.dev", "custom_domain": true },
    { "pattern": "www.educateos.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
