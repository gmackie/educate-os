# The in-browser demo (SCHO-224) promises that nothing leaves the visitor's browser beyond its own
# static files. no-transform keeps Cloudflare's edge from rewriting its HTML, which is how the
# zone's Web Analytics beacon would otherwise be injected into every page, the demo's included.
# It is set on the page alone: it also stops the edge compressing a response, and the demo's
# script is over 3 MB before compression (SCHO-321).
/demo
  Cache-Control: no-transform
/demo/
  Cache-Control: no-transform
/demo/index.html
  Cache-Control: no-transform

# The demo's build names every asset by its content's hash, so a browser may keep one for good.
/demo/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The demo videos (SCHO-343) carry a version in each name (-v1, -v2 ...), so a browser may keep one
# for good. The Worker serves them first, for Safari's byte ranges (video-range.mjs), and sets the
# same header itself.
/assets/videos/*
  Cache-Control: public, max-age=31536000, immutable

# Closed intake pages add no tracking. CSP also prevents zone analytics/beacon injection.
/interest/*
  Cache-Control: no-store, no-transform
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
/advisory/*
  Cache-Control: no-store, no-transform
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
/feedback/*
  Cache-Control: no-store, no-transform
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
/unsubscribe/*
  Cache-Control: no-store, no-transform
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# Marketplace listings (SCHO-209) are public, signed files a district verifies itself, so any
# origin may read them, such as a district's own console fetching one for its administrator.
/marketplace/*
  Access-Control-Allow-Origin: *

# The course catalog's signed course files (SCHO-333) are public, and a district verifies each
# itself, so any origin may read them, as for marketplace listings.
/courses/*
  Access-Control-Allow-Origin: *
