# The in-browser demo (SCHO-224) promises that nothing leaves the visitor's browser beyond its own
# static files. no-transform keeps Cloudflare's edge from rewriting its HTML, which is how the
# zone's Web Analytics beacon would otherwise be injected into every page, the demo's included.
/demo/*
  Cache-Control: no-transform

# Closed intake pages add no tracking. CSP also prevents zone analytics/beacon injection.
/interest/*
  Cache-Control: no-store, no-transform
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
