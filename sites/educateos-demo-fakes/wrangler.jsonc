// The public provider-fakes Worker of the EducateOS demo districts (SCHO-210). Hand-written, like
// sites/educateos-io's: it lives outside `packages/` because release discovery
// (`readDeployablePackages` in scripts/release/manifest-lib.ts), the staging, preview and production
// config generators, the dev server and `pnpm configs:generate` scan only `packages/`, and this
// Worker is our own demo infrastructure, never part of a district release.
//
// Secrets (`wrangler secret put`): FAKES_SECRET, at least 32 characters, from which every fake
// credential is derived; and ADMIN_ACCESS_AUD, the audience tag of the Access application in front
// of /_admin/* (unset refuses every admin request). ADMIN_ACCESS_AUD is not a secret, but as one it
// survives `wrangler deploy`, which replaces every var with this file's. See README.md.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "educateos-demo-fakes",
  "account_id": "c07a7e704db1808e1fff91bed2b1cd49",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-04",
  "routes": [
    { "pattern": "fakes.demo.educateos.io", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Invocation logs would record request URLs, and an LTI registration's OpenID configuration
    // URL carries its registration token.
    "logs": { "invocation_logs": false }
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://fakes.demo.educateos.io",
    // Where the OIDC fakes may send a signed-in user back to: the Access team's callback, for a
    // demo district whose Access application signs in through a fake issuer. Comma-separated,
    // exact-match; `{slug}` is the district.
    "OIDC_REDIRECT_URIS": "https://gmacko.cloudflareaccess.com/cdn-cgi/access/callback",
    "RATE_LIMIT_PER_MINUTE": "600"
  },
  // One object per demo district, reached through ctx.exports; no binding is needed.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DemoFakesDistrict"] }
  ]
}
