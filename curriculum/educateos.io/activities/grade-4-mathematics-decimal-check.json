    "overview": "Show what you know about tenths, hundredths and decimals.",
    "problems": [
      {
        "prompt": "Fill in the blank: 6/10 = ?/100."
      },
      {
        "prompt": "Add: 3/10 + 9/100."
      },
      {
        "prompt": "Write 39/100 as a decimal."
      },
      {
        "prompt": "Write 0.05 as a fraction."
      },
      {
        "prompt": "Write four and six tenths as a decimal."
      },
      {
        "prompt": "Compare 0.52 and 0.6. Write <, > or =, and explain."
      },
      {
        "prompt": "Order these decimals from least to greatest: 1.3, 1.03, 1.31."
      },
      {
        "prompt": "A plant grew 0.4 centimeters on Monday and 0.35 centimeters on Tuesday. On which day did it grow more? Write both amounts in hundredths to explain."
      },
      {
        "prompt": "Show $0.47 using the fewest dimes and pennies. Write it as a fraction of a dollar."
      }
