    "overview": "Tell time to the hour and half hour, then read a class chart.",
    "problems": [
      {
        "prompt": "The short hand points to 3. The long hand points to 12. What time is it?"
      },
      {
        "prompt": "The short hand is halfway between 7 and 8. The long hand points to 6. What time is it?"
      },
      {
        "prompt": "Draw a clock that shows 9:00."
      },
      {
        "prompt": "Draw a clock that shows 4:30."
      },
      {
        "prompt": "A digital clock says 11:30. Say the time in words."
      },
      {
        "prompt": "Our class chart shows how we get to school. Walk: 5 children. Bus: 8 children. Car: 3 children. How many more children ride the bus than walk?"
      },
      {
        "prompt": "Use the same chart. How many children are on the chart in all?"
      }
