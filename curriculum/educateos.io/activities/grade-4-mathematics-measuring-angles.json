    "gradeBand": "4",
    "overview": "Use a protractor to draw angles, and add and subtract angle measures to find unknown angles.",
    "problems": [
      {
        "prompt": "Use a protractor to draw an angle of 40 degrees. Take a photo of your angle."
      },
      {
        "prompt": "Use a protractor to draw an angle of 125 degrees. Is it acute, right or obtuse?"
      },
      {
        "prompt": "A right angle is split into two smaller angles. One of them measures 35 degrees. What does the other one measure? Write an equation."
      },
      {
        "prompt": "A straight angle (180 degrees) is split into three angles. Two of them measure 60 degrees and 45 degrees. What does the third angle measure?"
      },
      {
        "prompt": "Angle ABC measures 150 degrees. Ray BD splits it into two angles. Angle ABD measures 95 degrees. What does angle DBC measure? Write an equation with a letter for the unknown angle."
      },
      {
        "prompt": "A round pizza is cut into 8 equal slices from the center. What is the angle at the tip of each slice?"
      },
      {
        "prompt": "A protractor has two rows of numbers. Explain how you know which row to read when you measure an angle."
      }
    ],
