    "gradeBand": "4",
    "overview": "Show what you know about lines, angles, shapes and symmetry.",
    "problems": [
      {
        "prompt": "Draw and label a ray, a line segment and a pair of perpendicular lines."
      },
      {
        "prompt": "Classify each angle as acute, right or obtuse: 30 degrees, 90 degrees, 150 degrees."
      },
      {
        "prompt": "Use a protractor to draw an angle of 70 degrees. Take a photo of your angle."
      },
      {
        "prompt": "A straight angle is split into two angles. One measures 112 degrees. What does the other measure? Write an equation."
      },
      {
        "prompt": "How many degrees is an angle that turns through 1/8 of a circle?"
      },
      {
        "prompt": "I have 4 sides, two pairs of parallel sides and four right angles, but my sides are not all the same length. What shape am I?"
      },
      {
        "prompt": "How many lines of symmetry does each have: a regular hexagon, the letter M, the letter Z?"
      },
      {
        "prompt": "A triangle has a 90-degree angle. What kind of triangle is it? Could it also have an obtuse angle? Explain."
      }
    ],
