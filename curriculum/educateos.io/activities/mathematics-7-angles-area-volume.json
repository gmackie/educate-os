{
  "activity": {
    "aiHelp": "hints-only",
    "due": {
      "days": 9,
      "kind": "after-install"
    },
    "gradeBand": "7",
    "overview": "Use angle relationships to find unknown angles, then find area, surface area and volume, and describe cross sections.",
    "problems": [
      {
        "prompt": "Two angles are complementary. One measures 28°. What does the other measure?"
      },
      {
        "prompt": "Two angles are supplementary. One measures 3x and the other measures x + 20. Write and solve an equation for x, then find both angles."
      },
      {
        "prompt": "Two straight lines cross. One of the four angles measures 115°. Find the other three angles and name each relationship you used."
      },
      {
        "prompt": "A garden is an L shape made of a 10 m by 4 m rectangle joined to a 6 m by 3 m rectangle. What is its area?"
      },
      {
        "prompt": "A box is a rectangular prism 8 inches long, 5 inches wide and 3 inches tall. Find its volume and its surface area."
      },
      {
        "prompt": "A tent is a triangular prism. The triangle has a base of 6 feet and a height of 4 feet, and the tent is 10 feet long. Find its volume."
      },
      {
        "prompt": "Describe the shape you get when you slice a right rectangular prism parallel to its base, and when you slice a right rectangular pyramid parallel to its base."
      }
    ],
