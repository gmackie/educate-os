    "gradeBand": "4",
    "overview": "Classify shapes by parallel and perpendicular sides and angles, and find lines of symmetry.",
    "problems": [
      {
        "prompt": "Which of these shapes always have two pairs of parallel sides: square, rectangle, rhombus, trapezoid, parallelogram? Explain."
      },
      {
        "prompt": "Draw a triangle that has a right angle. What is this kind of triangle called?"
      },
      {
        "prompt": "Can a triangle have two right angles? Explain why or why not."
      },
      {
        "prompt": "Name a shape that has perpendicular sides and a shape that has no perpendicular sides."
      },
      {
        "prompt": "How many lines of symmetry does each one have: a square, a rectangle that is not a square, an equilateral triangle, the letter A, the letter H, the letter F?"
      },
      {
        "prompt": "Draw a shape that has exactly one line of symmetry. Draw the line of symmetry and take a photo."
      },
      {
        "prompt": "Is every square a rectangle? Explain using sides and angles."
      }
    ],
