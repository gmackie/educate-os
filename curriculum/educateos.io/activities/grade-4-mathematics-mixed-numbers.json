    "gradeBand": "4",
    "overview": "Add and subtract mixed numbers and multiply fractions by whole numbers to solve hiking problems.",
    "problems": [
      {
        "prompt": "Jo hiked 1 3/4 miles in the morning and 2 2/4 miles in the afternoon. How far did Jo hike in all?"
      },
      {
        "prompt": "A trail is 3 1/8 miles long. Sam has hiked 1 5/8 miles. How much farther does Sam have to go?"
      },
      {
        "prompt": "Write 2 3/5 as a fraction greater than 1."
      },
      {
        "prompt": "Write 11/4 as a mixed number."
      },
      {
        "prompt": "Each snack bag holds 2/3 cup of trail mix. How much trail mix is needed for 4 bags? Write a multiplication equation."
      },
      {
        "prompt": "Ben drinks 3/8 liter of water every hour for 5 hours. How much water does he drink? Between which two whole numbers of liters is your answer?"
      },
      {
        "prompt": "Subtract: 5 − 2 1/3."
      }
    ],
