  "readings": [
    {
      "attribution": "Written for EducateOS.",
      "body": "My grandpa's hands are maps,\nwith rivers running blue\nand roads of tiny wrinkles\nfrom all the work they knew.\n\nThey built the porch we sit on.\nThey planted every tree.\nThey once held my mother\nand now they carry me.\n\nHis hands are slow as Sunday\nwhen they button up his coat,\nbut when he shows me how to fish\nthey dance across the boat.\n\nI trace the roads and rivers\nand think of every place\nthose hands will someday show me,\nand smile up at his face.",
      "id": "grandpas-hands",
      "title": "Grandpa's Hands"
    }
  ],
