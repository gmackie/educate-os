    "gradeBand": "4",
    "overview": "Compare fractions using benchmarks, common denominators and common numerators.",
    "problems": [
      {
        "prompt": "Compare 3/8 and 1/2. Use 1/2 as a benchmark. Write <, > or =."
      },
      {
        "prompt": "Compare 5/6 and 5/8. Explain how you know without finding a common denominator."
      },
      {
        "prompt": "Compare 2/3 and 3/4 by writing both fractions with a denominator of 12."
      },
      {
        "prompt": "Compare 7/10 and 3/5. Show your work."
      },
      {
        "prompt": "Kai ran 4/5 of a mile. Lena ran 7/10 of a mile. Who ran farther? Explain."
      },
      {
        "prompt": "Order these fractions from least to greatest: 1/3, 5/12, 1/4."
      },
      {
        "prompt": "Mia ate 1/2 of a small pizza. Leo ate 1/4 of a very large pizza. Mia says she ate more because 1/2 > 1/4. Is she sure to be right? Explain."
      }
    ],
