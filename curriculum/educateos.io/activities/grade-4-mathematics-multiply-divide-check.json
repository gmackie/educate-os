    "overview": "Show what you know about multiplying, dividing and solving word problems.",
    "problems": [
      {
        "prompt": "Multiply: 5 × 618."
      },
      {
        "prompt": "Multiply: 47 × 32. Show an area model or partial products."
      },
      {
        "prompt": "Multiply: 2,045 × 4."
      },
      {
        "prompt": "Divide: 852 ÷ 6."
      },
      {
        "prompt": "Divide: 1,000 ÷ 7. Write the quotient and the remainder."
      },
      {
        "prompt": "Write 48 = 6 × 8 as a comparison sentence."
      },
      {
        "prompt": "A tree is 9 times as tall as a bush. The bush is 4 feet tall. How tall is the tree? Write an equation with a letter for the unknown."
      },
      {
        "prompt": "A baker has 214 cupcakes. Each box holds 6 cupcakes. How many boxes does the baker need to hold all the cupcakes? Explain what you did with the remainder."
      },
      {
        "prompt": "A theater has 18 rows with 24 seats in each row. 389 tickets were sold for a show. How many seats are empty? Use estimation to check that your answer is reasonable."
      }
    ],
