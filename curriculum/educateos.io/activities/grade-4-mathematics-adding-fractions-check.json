    "overview": "Show what you know about adding, subtracting and multiplying fractions.",
    "problems": [
      {
        "prompt": "Add: 3/10 + 4/10."
      },
      {
        "prompt": "Subtract: 7/12 − 5/12."
      },
      {
        "prompt": "Write 6/8 as a sum of three fractions with a denominator of 8."
      },
      {
        "prompt": "Ana painted 2/6 of a fence on Saturday and 3/6 of it on Sunday. How much of the fence has she painted? How much is left to paint?"
      },
      {
        "prompt": "Add: 2 3/8 + 1 6/8. Write your answer as a mixed number."
      },
      {
        "prompt": "Subtract: 4 1/5 − 1 3/5."
      },
      {
        "prompt": "Find 6 × 1/4. Write the answer as a fraction and as a mixed number."
      },
      {
        "prompt": "A recipe uses 3/4 cup of flour for each batch. How much flour is needed for 3 batches?"
      },
      {
        "prompt": "Rory wrote 1/5 + 2/5 = 3/10. Explain Rory's mistake and give the correct answer."
      }
    ],
