{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The CLI and the release-directory reader use node:fs; the library itself uses only fetch,
    // Web Crypto and the other globals workerd also provides.
    "types": ["node"],
    // Node runs these sources directly (the CLI), so specifiers name the file on disk and only
    // erasable TypeScript syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "__tests__"],
  "exclude": ["dist", "node_modules"]
}
