{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Only because the parent packages' sources (`@educateos/academics`) use `crypto`, `console` and
    // web globals. This package imports nothing from Node, so it runs unchanged under workerd.
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "__tests__", "vitest.worker.config.ts"],
  // The workerd suite is checked by tsconfig.workerd.json, against the Workers runtime types.
  "exclude": ["dist", "node_modules", "__tests__/workerd"]
}
