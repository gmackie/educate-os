{
  // The School app frame's TS config; the Worker uses tsconfig.json.
  "compilerOptions": {
    // Standalone config (no extends): mirror the root tsconfig's singleThreaded.
    "singleThreaded": true,
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["app", "src/school-app-api.ts"]
}
