{
  "name": "@educateos/gatekeeper",
  "version": "0.1.0",
  "private": true,
  "description": "The EducateOS gatekeeper (A02b, SCHO-57): a Workshop gatekeeper Worker whose connected account gives agents the district's school tools as the principal the district verified, with reads recorded as observations and every write waiting for a person's decision. Its account also provides the School app (SCHO-218): the district's own screens in the Workshop, with sidebar entries from the person's roles and classes.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "echo \"run 'pnpm dev-server' in the root directory instead\" >&2 && exit 1",
    "deploy": "vp run --no-cache build:app && wrangler deploy",
    "typecheck:app": "tsc -p tsconfig.app.json && tsc -p tsconfig.vite.json",
    "test:run": "vitest run && vitest run -c vitest.worker.config.ts"
  },
  "dependencies": {
    "@educateos/contracts": "workspace:*",
    "@educateos/policy": "workspace:*",
    "@gadgets/gatekeeper-kit": "workspace:*",
    "@gadgets/workshop-shared": "workspace:*",
    "capnweb": "catalog:",
    "capnweb-validate": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@cloudflare/vitest-plugin": "catalog:",
    "@educateos/academics": "workspace:*",
    "@educateos/admin-ui": "workspace:*",
    "@educateos/api-client": "workspace:*",
    "@educateos/fixtures": "workspace:*",
    "@educateos/student-ui": "workspace:*",
    "@educateos/teacher-ui": "workspace:*",
    "@gadgets/scripts": "workspace:*",
    "@gadgets/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "miniflare": "catalog:",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plus": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
