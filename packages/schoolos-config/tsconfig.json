{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Node types only for the Web Crypto global (`crypto.subtle`), which Workers provide too.
    "types": ["node"],
    // Node runs these sources directly (the F02 harness), so specifiers name the file on disk and
    // only erasable TypeScript syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "__tests__"],
  "exclude": ["dist", "node_modules"]
}
