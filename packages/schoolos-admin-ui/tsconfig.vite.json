{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    // Standalone, so explicit: an emitted `vite.config.js` would shadow `vite.config.ts`.
    "noEmit": true
  },
  "include": ["vite.config.ts"]
}
