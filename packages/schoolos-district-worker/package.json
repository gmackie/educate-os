    "@schoolos/district-app": "workspace:*",
    "@schoolos/gatekeeper": "workspace:*",
    "@schoolos/identity": "workspace:*",
    "@schoolos/policy": "workspace:*",
    "@schoolos/workspaces": "workspace:*",
    "capnweb": "catalog:",
    "capnweb-validate": "catalog:",
    "jose": "^6.2.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@gadgets/scripts": "workspace:*",
