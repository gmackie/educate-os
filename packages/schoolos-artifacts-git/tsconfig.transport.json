// The smart HTTP transport and its test, typechecked as gatekeeper-kit's own transport module is:
// against Workers types. `erasableSyntaxOnly` is off only because the kit's module uses a
// parameter property; this package's own code stays erasable (tsconfig.json checks the rest).
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental"],
    "paths": {
      "@gadgets/observability/*": ["../observability/src/*"],
      "@gadgets/workshop-shared/*": ["../workshop-shared/src/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src/smart-http.ts", "__tests__/smart-http.test.ts"],
  "exclude": ["dist", "node_modules"]
}
