// The smart HTTP transport and its test, typechecked against Workers types (ADR-0009). Its own code
// and gatekeeper-kit's transport module both compile on the web-standard surface; what does not is
// the kernel module (`@gadgets/workshop-shared/gatekeeper`) the kit's transport type-imports its
// pull-side types from, which is Workers-typed.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/smart-http.ts", "__tests__/smart-http.test.ts"],
  "exclude": ["dist", "node_modules"]
}
