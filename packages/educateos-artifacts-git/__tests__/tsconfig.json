{
  // The tests run under Node and read packs back with the `git` CLI, so they add Node's typings to the
  // web-standard surface the library is checked against (ADR-0009).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["."],
  // The smart HTTP transport test is checked with the transport; see ../tsconfig.transport.json.
  "exclude": ["smart-http.test.ts"]
}
