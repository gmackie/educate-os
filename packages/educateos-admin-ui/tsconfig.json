{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // The route schemas the API client validates with are checked here too; they are written against
    // the web-standard surface (ADR-0009), so the DOM typings take them as they are. `vite/client`
    // types the stylesheet import.
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
