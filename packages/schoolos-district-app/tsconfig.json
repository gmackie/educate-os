{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // For the fetch-standard globals, `crypto` and `console`. `types/` reconciles the Content Studio
    // sources, which are typed against Workers, with Node's typings. The code imports nothing from
    // Node, so it runs unchanged under workerd and Node alike.
    "types": ["node"],
    "paths": {
      // The type-only stand-in @schoolos/artifacts-git's Node typecheck uses for the Workers-typed
      // module gatekeeper-kit imports; see that package's tsconfig.
      "@gadgets/workshop-shared/gatekeeper": ["../schoolos-artifacts-git/types/workshop-shared-gatekeeper.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "__tests__", "types"],
  "exclude": ["dist", "node_modules"]
}
