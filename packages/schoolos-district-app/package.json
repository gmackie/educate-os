{
  "name": "@schoolos/district-app",
  "version": "0.1.0",
  "private": true,
  "description": "The SchoolOS district application: the merged domain services composed behind one typed, fetch-standard /api surface for the Student, Teacher and Admin UIs, with in-memory stores and, at `./durable-stores`, every store in one Durable Object's SQLite. A library: `@schoolos/district-worker` deploys it.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes.ts",
    "./guard-directory": "./src/guard-directory.ts",
    "./durable-stores": "./src/durable-stores.ts"
  },
  "dependencies": {
    "@schoolos/academics": "workspace:*",
    "@schoolos/ai-governance": "workspace:*",
    "@schoolos/artifacts-git": "workspace:*",
    "@schoolos/assessment": "workspace:*",
    "@schoolos/assessment-ci": "workspace:*",
    "@schoolos/cartridge": "workspace:*",
    "@schoolos/catalog": "workspace:*",
    "@schoolos/config": "workspace:*",
    "@schoolos/content-studio": "workspace:*",
    "@schoolos/contracts": "workspace:*",
    "@schoolos/curriculum": "workspace:*",
    "@schoolos/identity": "workspace:*",
    "@schoolos/identity-links": "workspace:*",
    "@schoolos/integrations": "workspace:*",
    "@schoolos/learning-artifacts": "workspace:*",
    "@schoolos/policy": "workspace:*",
    "@schoolos/registry": "workspace:*",
    "@schoolos/workspaces": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gadgets/scripts": "workspace:*",
    "@schoolos/fixtures": "workspace:*",
    "@types/node": "26.1.0",
    "vitest": "catalog:"
  }
}
