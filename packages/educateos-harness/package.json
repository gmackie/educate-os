{
  "name": "@educateos/harness",
  "version": "0.1.0",
  "private": true,
  "description": "Boots the synthetic EducateOS districts locally as isolated instances with fake identity, roster and AI providers, each serving the full district application with demo content, seeds the K-12 showcase through any district's API (`seedShowcase`), and installs the educateos.io sample courses into its classes (`installSampleCourses`). Development tooling, not a deployable Worker.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./demo-district": "./src/demo-district.ts",
    "./pilot": "./src/pilot/index.ts",
    "./pinned-fetch": "./src/pinned-fetch.ts",
    "./sample-courses": "./src/sample-courses.ts",
    "./school-day": "./src/school-day.ts",
    "./showcase": "./src/showcase.ts"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "community": "node src/community.ts",
    "pilot": "node src/pilot-cli.ts"
  },
  "dependencies": {
    "@educateos/api-client": "workspace:*",
    "@educateos/catalog": "workspace:*",
    "@educateos/content-studio": "workspace:*",
    "@educateos/contracts": "workspace:*",
    "@educateos/curriculum": "workspace:*",
    "@educateos/district-app": "workspace:*",
    "@educateos/fixtures": "workspace:*",
    "@educateos/identity": "workspace:*"
  },
  "devDependencies": {
    "@gadgets/scripts": "workspace:*",
    "@educateos/academics": "workspace:*",
    "@educateos/policy": "workspace:*",
    "@educateos/portability": "workspace:*",
    "@educateos/zip": "workspace:*",
    "vitest": "catalog:"
  }
}
