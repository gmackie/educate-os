{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The web-standard surface Workers, Node 24 and browsers share (ADR-0009), plus Node's
    // typings: this package is a Node program, not only a library.
    "types": ["node"],
    // Node runs these sources directly, so specifiers name the file on disk and only erasable
    // TypeScript syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "__tests__", "scripts"],
  "exclude": ["dist", "node_modules"]
}
