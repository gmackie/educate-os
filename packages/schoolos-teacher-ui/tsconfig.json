{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // The route schemas the API client validates with are written against the web-standard surface
    // (ADR-0009), so the DOM typings take them as they are. Node's typings are for the Vite config
    // and the screenshot script.
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "__tests__", "scripts", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
