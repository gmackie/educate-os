{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The workerd suite runs on the Workers runtime, not Node (ADR-0009, item 5).
    "types": ["@cloudflare/workers-types"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "__tests__/workerd", "__tests__/support.ts"],
  "exclude": ["dist", "node_modules"]
}
