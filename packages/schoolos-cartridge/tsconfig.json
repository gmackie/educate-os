{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Inflating uses the Workers `DecompressionStream`, package digests the Workers `crypto.subtle`.
    "types": ["@cloudflare/workers-types"],
    // Node runs these sources directly, so specifiers name the file on disk and only erasable
    // TypeScript syntax is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
